import turtle as trt
import time

# ------------------- Setup Screen -------------------
win = trt.Screen()
win.setup(1250, 650)
win.title("Hey My Favourite Girl")
win.bgcolor('white')

# ------------------- Create main turtle -------------------
a = trt.Turtle()
a.speed(3)
a.hideturtle()
a.width(4)

# ------------------- Functions for heart -------------------
def curve():
    for i in range(200):
        a.right(1)
        a.forward(1)

def heart():
    a.fillcolor('red')
    a.begin_fill()
    a.left(140)
    a.forward(113)
    win.bgcolor('#ffcccc')
    curve()
    a.left(120)
    curve()
    a.forward(112)
    a.end_fill()

# ------------------- Draw Heart -------------------
a.penup()
a.setpos(0,-100)
a.pendown()
heart()

